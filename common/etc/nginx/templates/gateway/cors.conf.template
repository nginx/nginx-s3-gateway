set $request_cors "${request_method}_${CORS_ENABLED}";

if ($request_cors = "GET_1") {
    add_header 'Access-Control-Allow-Origin' '${CORS_ALLOWED_ORIGIN}' always;
    # Keep in sync with cors_preflight.conf.template's method policy.
    add_header 'Access-Control-Allow-Methods' '${LIMIT_METHODS_TO_CSV}' always;
    add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
    add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
}

if ($request_cors = "HEAD_1") {
    add_header 'Access-Control-Allow-Origin' '${CORS_ALLOWED_ORIGIN}' always;
    # Keep in sync with cors_preflight.conf.template's method policy.
    add_header 'Access-Control-Allow-Methods' '${LIMIT_METHODS_TO_CSV}' always;
    add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
    add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;
}
