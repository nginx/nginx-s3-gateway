# Pull from NGINX image that provides the XSLT module and supporting libraries
FROM private-registry.nginx.com/nginx-plus/modules:r37.2-xslt-debian@sha256:3f8c5d518e0df32dcfe35782ac8498fff85dba2c248951adf5ff6cf57d7eef2f AS xslt

# PLS.37.2.0.1 CR is based on nginx 1.31.6, including predicate locations
# and their nested-lookup fixes (GH-609). The shared templates require this
# CR baseline; 37.0 LTS does not support them. Pin both images to the same
# Plus release, and check the installed package and binary below.
FROM private-registry.nginx.com/nginx-plus/base:r37.2-debian-trixie@sha256:a106c39340db78233bbb2847e78882258f12fb079f3757ce5ebac050066d3e6c

# Proxy cache env vars
ENV PROXY_CACHE_MAX_SIZE=10g
ENV PROXY_CACHE_INACTIVE=60m
ENV PROXY_CACHE_SLICE_SIZE=1m
ENV PROXY_CACHE_VALID_OK=1h
ENV PROXY_CACHE_VALID_NOTFOUND=1m
ENV PROXY_CACHE_VALID_FORBIDDEN=30s
ENV PROXY_CACHE_BYPASS_NO_CACHE=false
ENV PROXY_CACHE_IGNORE_HEADERS=""

# Access log env vars
ENV ACCESS_LOG_CACHE_STATUS=false

# Restrict the base image's template renderer (20-envsubst-on-templates.sh) to
# ALL-CAPS variable names: every gateway setting is uppercase, while the nginx
# runtime variables the templates must keep literally ($status, $remote_addr,
# $upstream_cache_status, ...) are lowercase and would otherwise be rewritten
# whenever a same-named environment variable happens to be set.
ENV NGINX_ENVSUBST_FILTER="^[A-Z0-9_]+$"

# CORS env vars
ENV CORS_ENABLED=0
ENV CORS_ALLOW_PRIVATE_NETWORK_ACCESS=""

# S3 proxy env vars
ENV DIRECTORY_LISTING_PATH_PREFIX=""
ENV DIRECTORY_LISTING_PAGE_SIZE=""
ENV STRIP_LEADING_DIRECTORY_PATH=""
ENV PREFIX_LEADING_DIRECTORY_PATH=""

# The modules image carries only the xslt module, its shared libraries and
# their package metadata - no nginx binary - so this whole-filesystem copy
# cannot replace the nginx-plus executable installed by the base image. The
# module still has to be built against the same nginx-plus release to load;
# the test suite covers that, since the config cannot be validated here (the
# templates are rendered and the license is mounted at container start).
COPY --from=xslt / /

COPY plus/etc/nginx /etc/nginx
COPY common/etc /etc
COPY common/docker-entrypoint.d /docker-entrypoint.d/

RUN <<EOF
    set -eux
    apt-get update -qq
    apt-get install --no-install-recommends --no-install-suggests -y \
      gettext-base libxml2 libxslt1.1
    apt-get remove --purge --auto-remove -y
    rm -rf /usr/share/doc/ /usr/share/lintian /var/lib/apt/lists

    test "$(dpkg-query -W -f '${Version}' nginx-plus)" = "37.2.0-1~trixie"
    nginx -v 2>&1 | grep -F "(nginx-plus-r37.2.0)"

    cat /etc/nginx/nginx-license.conf >> /etc/nginx/nginx.conf; \
    rm /etc/nginx/nginx-license.conf; \
    mkdir -p /var/cache/nginx/s3_proxy; \
    chown nginx:nginx /var/cache/nginx/s3_proxy; \
    find /docker-entrypoint.d -type f \( -name '*.sh' -or -name '*.envsh' \) -exec chmod -v +x {} \;
EOF
