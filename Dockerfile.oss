FROM nginx:1.31.7@sha256:8632b3314d74c61f0e27f59055bab13f7793b988c94c090154d867bc29e0f39b

# Proxy cache env vars
ENV PROXY_CACHE_MAX_SIZE=10g
ENV PROXY_CACHE_INACTIVE=60m
ENV PROXY_CACHE_SLICE_SIZE=1m
ENV PROXY_CACHE_VALID_OK=1h
ENV PROXY_CACHE_VALID_NOTFOUND=1m
ENV PROXY_CACHE_VALID_FORBIDDEN=30s
ENV PROXY_CACHE_BYPASS_NO_CACHE=false
ENV PROXY_CACHE_IGNORE_HEADERS=""

# Access log env vars
ENV ACCESS_LOG_CACHE_STATUS=false

# Restrict the base image's template renderer (20-envsubst-on-templates.sh) to
# ALL-CAPS variable names: every gateway setting is uppercase, while the nginx
# runtime variables the templates must keep literally ($status, $remote_addr,
# $upstream_cache_status, ...) are lowercase and would otherwise be rewritten
# whenever a same-named environment variable happens to be set.
ENV NGINX_ENVSUBST_FILTER="^[A-Z0-9_]+$"

# CORS env vars
ENV CORS_ENABLED=0
ENV CORS_ALLOW_PRIVATE_NETWORK_ACCESS=""

# S3 proxy env vars
ENV DIRECTORY_LISTING_PATH_PREFIX=""
ENV DIRECTORY_LISTING_PAGE_SIZE=""
ENV STRIP_LEADING_DIRECTORY_PATH=""
ENV PREFIX_LEADING_DIRECTORY_PATH=""

# We modify the NGINX base image by:
# 1. Explicitly installing the version of njs coded in the environment variable above.
# 2. Adding configuration files needed for proxying private S3 buckets.
# 3. Adding a directory for proxied objects to be stored.
# 4. Replacing the entrypoint script with a modified version that explicitly sets resolvers.

# Note: the NGINX_VERSION, NJS_VERSION, NJS_RELEASE, PKG_RELEASE and
# DYNPKG_RELEASE environment variables are inherited from the base image.
#
# The module packages are pinned to the base image's own nginx release. An
# unpinned install resolves to the newest mainline packages, and because
# nginx-module-njs depends on an exact nginx version, apt then upgrades (or
# could downgrade) the nginx binary itself - the shipped version would be
# decided by whatever the repository served on build day rather than by the
# FROM pin above. The trailing check fails the build if the installed binary
# and the pinned release ever disagree.

RUN set -x \
    && echo "deb [signed-by=/etc/apt/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/debian/ $(echo $PKG_RELEASE | cut -f2 -d~) nginx" >> /etc/apt/sources.list.d/nginx.list \
    && apt-get update \
    && apt-get install --no-install-recommends --no-install-suggests -y \
      libedit2 \
      nginx-module-njs=${NGINX_VERSION}+${NJS_VERSION}-${NJS_RELEASE} \
      nginx-module-xslt=${NGINX_VERSION}-${DYNPKG_RELEASE} \
    && apt-get remove --purge --auto-remove -y && rm -rf /var/lib/apt/lists/* \
    && test "$(nginx -v 2>&1)" = "nginx version: nginx/${NGINX_VERSION}" \
    && test "$(dpkg-query -W -f '${Version}' nginx)" = "${NGINX_VERSION}-${PKG_RELEASE}"

COPY oss/etc/nginx /etc/nginx
COPY common/etc /etc
COPY common/docker-entrypoint.d /docker-entrypoint.d/

RUN set -x \
    && mkdir -p /var/cache/nginx/s3_proxy \
    && chown nginx:nginx /var/cache/nginx/s3_proxy \
    && find /docker-entrypoint.d -type f \( -name '*.sh' -or -name '*.envsh' \) -exec chmod -v +x {} \;
